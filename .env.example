# Environment variables template for TheTimeThen
# Copy this to .env and fill in actual values
# DO NOT commit .env to Git - it contains paths and API keys

# Shared storage paths (using OneDrive for cloud sync)
# These folders must exist before running Docker!
# Windows example: D:/Nvisions OneDrive/OneDrive/TheTimeThen-Data/data
# Linux example: /mnt/sync/TheTimeThen-Data/data
# Mac example: /Users/YourName/OneDrive/TheTimeThen-Data/data

DB_VOLUME_PATH=D:/Nvisions OneDrive/OneDrive/TheTimeThen-Data/data
OUTPUT_VOLUME_PATH=D:/Nvisions OneDrive/OneDrive/TheTimeThen-Data/output

# OpenAI API Key (get from https://platform.openai.com/api-keys)
# Keep this private! Do not commit .env to Git
OPENAI_API_KEY=sk-your-key-here

# Optional: Container resource limits
# DOCKER_CPUS=4
# DOCKER_MEMORY=8g

